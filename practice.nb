Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Full", " ", "processing", " ", "cycle", " ", "example", " ", "on", " ", 
    "the", " ", "synthetic", " ", "dataset", " ", "NoisyMix"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "2000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"noisyMix", "=", 
     RowBox[{"Dataset", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<age\>\"", "->", 
           RowBox[{"RandomReal", "[", 
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"35", ",", "10"}], "]"}], "]"}]}], ",", 
          RowBox[{"\"\<income\>\"", "->", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"RandomReal", "[", "]"}], "<", "0.11"}], ",", 
             RowBox[{"Missing", "[", "]"}], ",", 
             RowBox[{"Exp", "[", 
              RowBox[{"RandomReal", "[", 
               RowBox[{"NormalDistribution", "[", 
                RowBox[{"10", ",", "1"}], "]"}], "]"}], "]"}]}], "]"}]}], ",", 
          RowBox[{"\"\<city\>\"", "->", 
           RowBox[{"RandomChoice", "[", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Minsk\>\"", ",", "\"\<Brest\>\"", 
              ",", "\"\<Gomel\>\"", ",", "\"\<Vitebsk\>\"", ",", 
              RowBox[{"Missing", "[", "]"}]}], "}"}], "]"}]}], ",", 
          RowBox[{"\"\<occupation\>\"", "->", 
           RowBox[{"RandomChoice", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"\"\<job\>\"", "<>", 
               RowBox[{"ToString", "[", "i", "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "22"}], "}"}]}], "]"}], "]"}]}], ",", 
          RowBox[{"\"\<is_active\>\"", "->", 
           RowBox[{"RandomChoice", "[", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}], "]"}]}]}], "|>"}], ",", 
        RowBox[{"{", "n", "}"}]}], "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"noisyMix", "[", 
    RowBox[{"[", 
     RowBox[{"1", ";;", "5"}], "]"}], "]"}]}]}]], "Input",
